---
import CicekGorseli from '../components/CicekGorseli.astro';
import { DUKKAN } from '../data/dukkan';
import { urunler } from '../data/urunler';
import { fiyatYaz, whatsappLinki } from '../lib/siparis';

const genelMesajLinki = whatsappLinki(`Merhaba ${DUKKAN.ad}, özel bir buket hakkında bilgi almak istiyorum.`);
const yil = new Date().getFullYear();
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{DUKKAN.ad} · {DUKKAN.slogan}</title>
    <meta name="description" content={`${DUKKAN.ad}: gül, lale, şakayık ve mevsim çiçekleri. WhatsApp'tan kolayca sipariş verin.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="ust">
      <div class="kap ust-ic">
        <a href="#" class="logo">🌷 {DUKKAN.ad}</a>
        <nav class="menu">
          <a href="#cicekler">Çiçekler</a>
          <a href="#nasil">Nasıl sipariş verilir?</a>
          <a href="#iletisim">İletişim</a>
        </nav>
        <button id="sepet-dugmesi" class="sepet-dugmesi" type="button" aria-label="Sepeti aç">
          🧺 Sepet <span id="sepet-sayisi" class="rozet">0</span>
        </button>
      </div>
    </header>

    <main>
      <section class="vitrin">
        <div class="kap vitrin-ic">
          <div>
            <p class="ust-baslik">{DUKKAN.ad}</p>
            <h1>{DUKKAN.slogan}</h1>
            <p class="giris">
              Gülden laleye, şakayıktan orkideye özenle hazırlanmış buketler. Sepetini oluştur,
              siparişin tek dokunuşla WhatsApp'tan bize ulaşsın.
            </p>
            <div class="eylemler">
              <a href="#cicekler" class="dugme birincil">Çiçekleri gör</a>
              <a href={genelMesajLinki} class="dugme ikincil" target="_blank" rel="noopener">WhatsApp'tan yaz</a>
            </div>
          </div>
          <div class="vitrin-gorsel" aria-hidden="true">
            <CicekGorseli tur="karisik" renkler={['#e2445c', '#ffffff', '#f2a93b', '#f2a7bb']} ad="" />
          </div>
        </div>
      </section>

      <section id="cicekler" class="kap bolum">
        <h2>Çiçeklerimiz</h2>
        <p class="bolum-alt">Fiyatlara buket kağıdı ve kurdele dahildir.</p>
        <ul class="urunler">
          {urunler.map((urun) => (
            <li class="kart">
              <div class="kart-gorsel">
                <CicekGorseli tur={urun.tur} renkler={urun.renkler} ad={urun.ad} />
              </div>
              <div class="kart-govde">
                <h3>{urun.ad}</h3>
                <p>{urun.aciklama}</p>
                <div class="kart-alt">
                  <span class="fiyat">{fiyatYaz(urun.fiyat)}</span>
                  <button type="button" class="dugme kucuk" data-sepete-ekle={urun.id}>Sepete ekle</button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="nasil" class="kap bolum">
        <h2>Nasıl sipariş verilir?</h2>
        <ol class="adimlar">
          <li><span>1</span><h3>Seç</h3><p>Beğendiğin çiçekleri sepete ekle.</p></li>
          <li><span>2</span><h3>Bilgileri yaz</h3><p>Teslimat adresini, tarihini ve kart notunu gir.</p></li>
          <li><span>3</span><h3>WhatsApp'tan gönder</h3><p>Siparişin hazır mesaj olarak bize gelir; ödeme ve teslimatı birlikte netleştiririz.</p></li>
        </ol>
      </section>
    </main>

    <footer id="iletisim" class="alt-bilgi">
      <div class="kap alt-ic">
        <div>
          <p class="logo">🌷 {DUKKAN.ad}</p>
          <p>{DUKKAN.slogan}</p>
        </div>
        <div>
          <p>WhatsApp / Telefon</p>
          <a href={genelMesajLinki} target="_blank" rel="noopener" class="telefon">{DUKKAN.telefonGorunen}</a>
        </div>
      </div>
      <p class="kap telif">© {yil} {DUKKAN.ad}</p>
    </footer>

    <dialog id="sepet" class="sepet" aria-labelledby="sepet-baslik">
      <div class="sepet-ust">
        <h2 id="sepet-baslik">Sepetim</h2>
        <button type="button" class="kapat" data-kapat aria-label="Sepeti kapat">✕</button>
      </div>
      <p id="sepet-bos" class="sepet-bos">Sepetin boş. Çiçeklerden birini ekleyerek başla 🌸</p>
      <ul id="sepet-listesi" class="sepet-listesi"></ul>
      <div id="sepet-icerik">
        <p class="toplam">Toplam <strong id="sepet-toplam">0 ₺</strong></p>
        <form id="siparis-formu" class="form">
          <label>Ad Soyad <input name="adSoyad" required autocomplete="name" /></label>
          <label>Teslimat adresi <textarea name="adres" rows="2" required autocomplete="street-address"></textarea></label>
          <label>Teslimat tarihi <input name="tarih" type="date" required /></label>
          <label>Kart notu <span class="istege-bagli">(isteğe bağlı)</span> <input name="kartNotu" maxlength="200" /></label>
          <button type="submit" class="dugme whatsapp">WhatsApp ile sipariş ver</button>
          <p class="not">Fiyat ve teslimat ücreti WhatsApp'ta teyit edilir.</p>
        </form>
      </div>
    </dialog>

    <div id="bildirim" class="bildirim" role="status" aria-live="polite"></div>

    <script>
      import {
        fiyatYaz,
        sepetSatirlari,
        siparisMesaji,
        toplamTutar,
        whatsappLinki,
        type Sepet,
        type TeslimatBilgisi,
      } from '../lib/siparis';
      import { urunler } from '../data/urunler';

      const ANAHTAR = 'cicekcim-sepet';

      function sepetiOku(): Sepet {
        try {
          const ham = localStorage.getItem(ANAHTAR);
          const veri: unknown = ham ? JSON.parse(ham) : {};
          return veri && typeof veri === 'object' ? (veri as Sepet) : {};
        } catch {
          return {};
        }
      }

      let sepet: Sepet = sepetiOku();

      function kaydet() {
        try {
          localStorage.setItem(ANAHTAR, JSON.stringify(sepet));
        } catch {
          // Gizli sekmede depolama kapalı olabilir; sepet yine bu sayfada çalışır.
        }
      }

      const $ = <T extends HTMLElement>(secici: string) => document.querySelector<T>(secici)!;
      const pencere = $<HTMLDialogElement>('#sepet');
      const liste = $<HTMLUListElement>('#sepet-listesi');
      const bos = $('#sepet-bos');
      const icerik = $('#sepet-icerik');
      const sayi = $('#sepet-sayisi');
      const toplam = $('#sepet-toplam');
      const form = $<HTMLFormElement>('#siparis-formu');
      const tarihAlani = form.querySelector<HTMLInputElement>('input[name="tarih"]')!;
      const bildirim = $('#bildirim');

      // Geçmiş bir güne teslimat seçilmesin
      const bugun = new Date();
      bugun.setMinutes(bugun.getMinutes() - bugun.getTimezoneOffset());
      tarihAlani.min = bugun.toISOString().slice(0, 10);

      function adetDegistir(id: string, fark: number) {
        const yeni = (sepet[id] ?? 0) + fark;
        if (yeni > 0) sepet[id] = yeni;
        else delete sepet[id];
        kaydet();
        ciz();
      }

      function ciz() {
        const satirlar = sepetSatirlari(sepet);
        const adet = satirlar.reduce((t, s) => t + s.adet, 0);
        sayi.textContent = String(adet);
        bos.hidden = satirlar.length > 0;
        icerik.hidden = satirlar.length === 0;
        toplam.textContent = fiyatYaz(toplamTutar(satirlar));

        liste.replaceChildren(
          ...satirlar.map(({ urun, adet, tutar }) => {
            const li = document.createElement('li');
            li.className = 'sepet-satiri';
            li.dataset.id = urun.id;
            li.innerHTML = `
              <div><p class="satir-ad"></p><p class="satir-tutar"></p></div>
              <div class="adet">
                <button type="button" data-azalt aria-label="Azalt">−</button>
                <span></span>
                <button type="button" data-artir aria-label="Artır">+</button>
              </div>`;
            li.querySelector('.satir-ad')!.textContent = urun.ad;
            li.querySelector('.satir-tutar')!.textContent = fiyatYaz(tutar);
            li.querySelector('.adet span')!.textContent = String(adet);
            return li;
          }),
        );
      }

      let bildirimZamani: number | undefined;
      function bildir(metin: string) {
        bildirim.textContent = metin;
        bildirim.classList.add('gorunur');
        clearTimeout(bildirimZamani);
        bildirimZamani = window.setTimeout(() => bildirim.classList.remove('gorunur'), 2200);
      }

      document.querySelectorAll<HTMLButtonElement>('[data-sepete-ekle]').forEach((dugme) => {
        dugme.addEventListener('click', () => {
          const id = dugme.dataset.sepeteEkle!;
          adetDegistir(id, 1);
          const urun = urunler.find((u) => u.id === id);
          if (urun) bildir(`${urun.ad} sepete eklendi`);
        });
      });

      liste.addEventListener('click', (olay) => {
        const hedef = (olay.target as HTMLElement).closest('button');
        const id = hedef?.closest<HTMLElement>('.sepet-satiri')?.dataset.id;
        if (!hedef || !id) return;
        if (hedef.hasAttribute('data-artir')) adetDegistir(id, 1);
        if (hedef.hasAttribute('data-azalt')) adetDegistir(id, -1);
      });

      $('#sepet-dugmesi').addEventListener('click', () => pencere.showModal());
      pencere.querySelector('[data-kapat]')!.addEventListener('click', () => pencere.close());
      // Karartılmış alana tıklayınca kapat
      pencere.addEventListener('click', (olay) => {
        if (olay.target === pencere) pencere.close();
      });

      form.addEventListener('submit', (olay) => {
        olay.preventDefault();
        const satirlar = sepetSatirlari(sepet);
        if (satirlar.length === 0) return;
        const veri = new FormData(form);
        const bilgi: TeslimatBilgisi = {
          adSoyad: String(veri.get('adSoyad') ?? '').trim(),
          adres: String(veri.get('adres') ?? '').trim(),
          tarih: String(veri.get('tarih') ?? ''),
          kartNotu: String(veri.get('kartNotu') ?? '').trim(),
        };
        window.open(whatsappLinki(siparisMesaji(satirlar, bilgi)), '_blank', 'noopener');
      });

      ciz();
    </script>

    <style is:global>
      :root {
        --zemin: #fbf7f2;
        --kart: #ffffff;
        --kart-gorsel: #f4efe6;
        --metin: #2b2a28;
        --soluk: #6d6a64;
        --yesil: #2f4a3a;
        --gul: #b5385a;
        --gul-koyu: #962c4a;
        --cizgi: #ece4d8;
        --whatsapp: #1f9d55;
        --golge: 0 6px 24px rgba(47, 74, 58, 0.08);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--zemin);
        color: var(--metin);
        font-family: 'Inter', system-ui, sans-serif;
        line-height: 1.55;
      }
      h1, h2, h3, .logo { font-family: 'Fraunces', Georgia, serif; font-weight: 600; color: var(--yesil); }
      a { color: inherit; }
      .kap { max-width: 1120px; margin: 0 auto; padding-inline: 20px; }

      .ust { position: sticky; top: 0; z-index: 10; background: rgba(251, 247, 242, 0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--cizgi); }
      .ust-ic { display: flex; align-items: center; gap: 24px; height: 64px; }
      .logo { font-size: 1.35rem; text-decoration: none; margin: 0; }
      .menu { display: flex; gap: 20px; margin-left: auto; }
      .menu a { text-decoration: none; color: var(--soluk); font-size: 0.95rem; }
      .menu a:hover { color: var(--yesil); }
      .sepet-dugmesi { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--cizgi); background: var(--kart); color: var(--metin); border-radius: 999px; padding: 8px 14px; font: inherit; font-weight: 500; cursor: pointer; }
      .rozet { background: var(--gul); color: #fff; border-radius: 999px; min-width: 22px; padding: 0 6px; font-size: 0.8rem; text-align: center; }

      .vitrin { background: linear-gradient(180deg, #f6eee6, var(--zemin)); }
      .vitrin-ic { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 32px; padding-top: 56px; padding-bottom: 56px; }
      .ust-baslik { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.8rem; color: var(--gul); font-weight: 600; margin: 0; }
      h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.1; margin: 10px 0 16px; }
      .giris { font-size: 1.1rem; color: var(--soluk); max-width: 34em; }
      .eylemler { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
      .vitrin-gorsel { max-width: 380px; justify-self: center; width: 100%; }

      .dugme { display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 999px; padding: 12px 22px; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; transition: background 0.15s, transform 0.15s; }
      .dugme:active { transform: scale(0.97); }
      .birincil { background: var(--gul); color: #fff; }
      .birincil:hover { background: var(--gul-koyu); }
      .ikincil { background: transparent; color: var(--yesil); box-shadow: inset 0 0 0 1.5px var(--yesil); }
      .kucuk { padding: 8px 16px; font-size: 0.9rem; background: var(--yesil); color: #fff; }
      .kucuk:hover { background: #23392c; }
      .whatsapp { background: var(--whatsapp); color: #fff; width: 100%; }
      .whatsapp:hover { background: #18834a; }

      .bolum { padding-top: 56px; padding-bottom: 24px; }
      h2 { font-size: 2rem; margin: 0 0 6px; }
      .bolum-alt { color: var(--soluk); margin: 0 0 28px; }
      .urunler { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 22px; }
      .kart { background: var(--kart); border-radius: 18px; overflow: hidden; box-shadow: var(--golge); display: flex; flex-direction: column; }
      .kart-gorsel { background: var(--kart-gorsel); padding: 18px 28px 6px; }
      .kart-govde { padding: 16px 18px 18px; display: flex; flex-direction: column; flex: 1; }
      .kart h3 { font-size: 1.15rem; margin: 0 0 4px; }
      .kart p { margin: 0; color: var(--soluk); font-size: 0.92rem; flex: 1; }
      .kart-alt { display: flex; align-items: center; justify-content: space-between; margin-top: 14px; }
      .fiyat { font-weight: 600; font-size: 1.1rem; color: var(--gul); }
      .cicek-gorseli { display: block; width: 100%; height: auto; }

      .adimlar { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
      .adimlar li { background: var(--kart); border-radius: 18px; padding: 22px; box-shadow: var(--golge); }
      .adimlar span { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #f6e3e8; color: var(--gul); font-weight: 600; }
      .adimlar h3 { margin: 12px 0 4px; font-size: 1.1rem; }
      .adimlar p { margin: 0; color: var(--soluk); }

      .alt-bilgi { margin-top: 64px; background: var(--yesil); color: #e9efe9; padding: 40px 0 20px; }
      .alt-bilgi .logo { color: #fff; }
      .alt-ic { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
      .alt-ic p { margin: 0 0 6px; }
      .telefon { font-size: 1.3rem; font-weight: 600; color: #fff; }
      .telif { margin-top: 28px; font-size: 0.85rem; opacity: 0.7; }

      .sepet { margin: 0 0 0 auto; height: 100dvh; max-height: 100dvh; width: min(420px, 100vw); max-width: 100vw; border: 0; padding: 24px; background: var(--zemin); color: var(--metin); overflow-y: auto; }
      .sepet::backdrop { background: rgba(30, 30, 30, 0.4); }
      .sepet-ust { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
      .sepet-ust h2 { font-size: 1.6rem; margin: 0; }
      .kapat { border: 0; background: none; font-size: 1.3rem; cursor: pointer; color: var(--soluk); }
      .sepet-bos { color: var(--soluk); }
      .sepet-listesi { list-style: none; padding: 0; margin: 0; }
      .sepet-satiri { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--cizgi); }
      .sepet-satiri p { margin: 0; }
      .satir-ad { font-weight: 500; }
      .satir-tutar { color: var(--soluk); font-size: 0.9rem; }
      .adet { display: flex; align-items: center; gap: 10px; }
      .adet button { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--cizgi); background: var(--kart); color: var(--metin); font-size: 1rem; cursor: pointer; }
      .toplam { display: flex; justify-content: space-between; font-size: 1.1rem; margin: 16px 0; }
      .form { display: grid; gap: 12px; }
      .form label { display: grid; gap: 4px; font-size: 0.9rem; font-weight: 500; }
      .form input, .form textarea { font: inherit; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--cizgi); background: var(--kart); color: var(--metin); }
      .form input:focus, .form textarea:focus { outline: 2px solid var(--gul); outline-offset: 1px; }
      .istege-bagli { color: var(--soluk); font-weight: 400; }
      .not { font-size: 0.82rem; color: var(--soluk); margin: 0; text-align: center; }
      [hidden] { display: none !important; }

      .bildirim { position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px); background: var(--yesil); color: #fff; padding: 10px 18px; border-radius: 999px; opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s; z-index: 20; }
      .bildirim.gorunur { opacity: 1; transform: translate(-50%, 0); }

      @media (max-width: 760px) {
        .menu { display: none; }
        .sepet-dugmesi { margin-left: auto; }
        .vitrin-ic { grid-template-columns: 1fr; padding-top: 32px; padding-bottom: 32px; }
        .vitrin-gorsel { max-width: 260px; grid-row: 1; }
        .adimlar { grid-template-columns: 1fr; }
        .kap { padding-inline: 16px; }
        .kart-gorsel .cicek-gorseli { max-width: 220px; margin: 0 auto; }
      }
    </style>
  </body>
</html>
