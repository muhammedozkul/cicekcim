---
// Ürün fotoğrafı yerine çizilen buket görseli. Gerçek fotoğraflar gelince <img> ile değiştirilebilir.
import type { CicekTuru } from '../data/urunler';

interface Props {
  tur: CicekTuru;
  renkler: string[];
  ad: string;
}

const { tur, renkler, ad } = Astro.props;

type TekTur = Exclude<CicekTuru, 'karisik'>;
const KARISIK_SIRA: TekTur[] = ['gul', 'papatya', 'lale', 'sakayik'];

const f = (n: number) => n.toFixed(1);

function gul(c: string, r: number): string {
  const s = r * 0.28;
  return `<circle r="${f(r)}" fill="${c}"/>
    <circle r="${f(r)}" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="1.5"/>
    <path d="M${f(-s)} 0 a${f(s)} ${f(s)} 0 1 1 ${f(2 * s)} 0 a${f(1.7 * s)} ${f(1.7 * s)} 0 1 1 ${f(-3.4 * s)} 0 a${f(2.4 * s)} ${f(2.4 * s)} 0 1 1 ${f(4.8 * s)} 0"
      fill="none" stroke="rgba(0,0,0,.22)" stroke-width="1.6" stroke-linecap="round"/>`;
}

function lale(c: string, r: number): string {
  return `<path d="M${f(-r * 0.8)} ${f(-r * 0.3)} C${f(-r * 0.95)} ${f(r * 0.95)} ${f(r * 0.95)} ${f(r * 0.95)} ${f(r * 0.8)} ${f(-r * 0.3)}
      L${f(r * 0.45)} ${f(-r)} L0 ${f(-r * 0.4)} L${f(-r * 0.45)} ${f(-r)} Z" fill="${c}"/>
    <path d="M0 ${f(-r * 0.4)} C${f(-r * 0.2)} 0 ${f(-r * 0.15)} ${f(r * 0.4)} 0 ${f(r * 0.62)}"
      fill="none" stroke="rgba(0,0,0,.18)" stroke-width="1.4"/>`;
}

function sakayik(c: string, r: number): string {
  const halka = (adet: number, uzaklik: number, yaricap: number, aci = 0) =>
    Array.from({ length: adet }, (_, i) => {
      const a = aci + (i / adet) * Math.PI * 2;
      return `<circle cx="${f(Math.cos(a) * uzaklik)}" cy="${f(Math.sin(a) * uzaklik)}" r="${f(yaricap)}"
        fill="${c}" stroke="rgba(255,255,255,.55)" stroke-width="1"/>`;
    }).join('');
  return halka(8, r * 0.58, r * 0.45) + halka(5, r * 0.28, r * 0.36, 0.4) +
    `<circle r="${f(r * 0.26)}" fill="${c}" stroke="rgba(0,0,0,.12)" stroke-width="1"/>`;
}

function papatya(c: string, r: number): string {
  const yapraklar = Array.from({ length: 14 }, (_, i) =>
    `<ellipse cy="${f(-r * 0.52)}" rx="${f(r * 0.2)}" ry="${f(r * 0.5)}" fill="${c}"
      stroke="#e4ddd0" stroke-width=".8" transform="rotate(${f((i * 360) / 14)})"/>`,
  ).join('');
  return yapraklar + `<circle r="${f(r * 0.3)}" fill="#f2b705"/>`;
}

function aycicegi(c: string, r: number): string {
  const yapraklar = Array.from({ length: 16 }, (_, i) =>
    `<path d="M0 ${f(-r * 0.35)} Q${f(r * 0.2)} ${f(-r * 0.7)} 0 ${f(-r)} Q${f(-r * 0.2)} ${f(-r * 0.7)} 0 ${f(-r * 0.35)}"
      fill="${c}" transform="rotate(${f((i * 360) / 16)})"/>`,
  ).join('');
  return yapraklar + `<circle r="${f(r * 0.44)}" fill="#5a3b1e"/>
    <circle r="${f(r * 0.3)}" fill="none" stroke="#7a5430" stroke-width="1.2" stroke-dasharray="1.5 2"/>`;
}

function orkide(c: string, r: number): string {
  const yaprak = (aci: number, rx: number, ry: number) =>
    `<ellipse cy="${f(-ry * 0.8)}" rx="${f(rx)}" ry="${f(ry)}" fill="${c}"
      stroke="#e2d6e4" stroke-width="1" transform="rotate(${aci})"/>`;
  return yaprak(0, r * 0.32, r * 0.55) + yaprak(130, r * 0.32, r * 0.55) + yaprak(230, r * 0.32, r * 0.55) +
    yaprak(65, r * 0.45, r * 0.5) + yaprak(295, r * 0.45, r * 0.5) +
    `<ellipse cy="${f(r * 0.15)}" rx="${f(r * 0.24)}" ry="${f(r * 0.3)}" fill="#b04a8c"/>
    <circle cy="${f(-r * 0.08)}" r="${f(r * 0.1)}" fill="#f2c94c"/>`;
}

const cizimler: Record<TekTur, (c: string, r: number) => string> = {
  gul, lale, sakayik, papatya, aycicegi, orkide,
};

// Buket yerleşimi: [x, y, yarıçap]
const buket: [number, number, number][] = [
  [100, 60, 19], [70, 76, 18], [130, 76, 18], [86, 100, 18], [114, 100, 18], [56, 104, 16], [144, 104, 16],
];
// Orkide: kavisli dal üstünde sıralı çiçekler
const orkideDali: [number, number, number][] = [
  [62, 66, 15], [86, 52, 16], [112, 50, 16], [138, 60, 15], [152, 82, 13],
];

const saksida = tur === 'orkide';
const yerlesim = saksida ? orkideDali : buket;
const sap: [number, number] = saksida ? [100, 140] : [100, 150];

const cicekler = yerlesim.map(([x, y, r], i) => {
  const t: TekTur = tur === 'karisik' ? KARISIK_SIRA[i % KARISIK_SIRA.length] : tur;
  const renk = renkler[i % renkler.length];
  return `<g transform="translate(${x} ${y})">${cizimler[t](renk, r)}</g>`;
}).join('');

const saplar = saksida
  ? `<path d="M100 140 C96 110 92 90 72 72 M92 92 C100 70 120 56 150 80" fill="none" stroke="#5d7f4f" stroke-width="2.5"/>`
  : yerlesim.map(([x, y]) => `<line x1="${x}" y1="${y}" x2="${sap[0]}" y2="${sap[1]}" stroke="#5d7f4f" stroke-width="2.5"/>`).join('');

const yapraklar = saksida
  ? `<ellipse cx="82" cy="138" rx="22" ry="7" fill="#4f7a4a" transform="rotate(-15 82 138)"/>
     <ellipse cx="118" cy="138" rx="22" ry="7" fill="#5d8a55" transform="rotate(15 118 138)"/>`
  : `<ellipse cx="48" cy="86" rx="16" ry="6" fill="#6b9a5e" transform="rotate(-40 48 86)"/>
     <ellipse cx="152" cy="86" rx="16" ry="6" fill="#6b9a5e" transform="rotate(40 152 86)"/>
     <ellipse cx="100" cy="38" rx="6" ry="14" fill="#7aa86b"/>`;

const alt = saksida
  ? `<path d="M70 140 L130 140 L121 184 L79 184 Z" fill="#ece6dc" stroke="#d6cdbf" stroke-width="1.5"/>
     <rect x="66" y="136" width="68" height="8" rx="3" fill="#f4efe7" stroke="#d6cdbf" stroke-width="1.5"/>`
  : `<path d="M54 116 L146 116 L114 184 L86 184 Z" fill="#dcbf97"/>
     <path d="M54 116 L100 142 L146 116 L118 180 L82 180 Z" fill="#cfae80"/>
     <path d="M88 150 Q100 144 112 150 L106 158 Q100 154 94 158 Z" fill="#b5475f"/>
     <circle cx="100" cy="150" r="4" fill="#9e3a50"/>`;

const zemin = renkler[0];
// Çizim sırası önemli: sonra gelen üstte görünür (buket kağıdı sapları örter, orkide yaprakları saksının üstünde durur).
const katmanlar = saksida
  ? [saplar, alt, yapraklar, cicekler]
  : [yapraklar, saplar, cicekler, alt];
const svg = `<circle cx="100" cy="100" r="92" fill="${zemin}" opacity=".13"/>${katmanlar.join('')}`;
---

<svg viewBox="0 0 200 200" role="img" aria-label={ad} class="cicek-gorseli" set:html={svg} />
